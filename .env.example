# Database. The docker compose service publishes Postgres on host port 5433.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/ai_sales_coach

# LLM backend: "stub" (deterministic, offline, no key needed) or "deepseek".
LLM_BACKEND=stub

# Required only when LLM_BACKEND=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Reproducibility: seed and temperature are fixed in app/config.py (42 / 0.0)
# and copied onto every review row. They are deliberately not env knobs.
